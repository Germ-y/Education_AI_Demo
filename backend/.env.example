APP_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL is the target DB. The first FastAPI slice can run with in-memory seed data.
DATABASE_URL=postgresql+psycopg://eduyj:eduyj@localhost:5432/eduyj

# AI providers
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-5.1
OPENAI_ORCHESTRATOR_MODEL=gpt-5.1
OPENAI_CONTENT_MODEL=gpt-5.1
OPENAI_CRITIQUE_MODEL=gpt-5.1
OPENAI_IMAGE_BRIEF_MODEL=gpt-5.1
OPENAI_REPORT_MODEL=gpt-5.1
OPENAI_SUPPORT_PROFILE_MODEL=gpt-5.1
OPENAI_MEMORY_MODEL=gpt-5.1
OPENAI_REASONING_EFFORT=none
OPENAI_TEXT_VERBOSITY=low
OPENAI_ORCHESTRATOR_MAX_OUTPUT_TOKENS=6000
OPENAI_CONTENT_MAX_OUTPUT_TOKENS=0
OPENAI_CRITIQUE_MAX_OUTPUT_TOKENS=4000
OPENAI_RESPONSE_TIMEOUT_SEC=300
OPENAI_ORCHESTRATOR_TIMEOUT_SEC=240
OPENAI_CONTENT_TIMEOUT_SEC=300
OPENAI_CRITIQUE_TIMEOUT_SEC=240
OPENAI_REPORT_TIMEOUT_SEC=180
OPENAI_SUPPORT_PROFILE_TIMEOUT_SEC=180
OPENAI_MEMORY_TIMEOUT_SEC=180
OPENAI_CONTENT_CRITIQUE_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT_SEC=420
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_VOICE_SPEED=0.92
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_STABILITY=0.42
ELEVENLABS_SIMILARITY_BOOST=0.82
ELEVENLABS_STYLE=0.32
ELEVENLABS_SPEED=1.03
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_ENABLE_AUDIO_TAGS=false

# Public data providers
PUBLIC_DATA_SYNC_ENABLED=false
NEIS_API_KEY=
PUBLIC_DATA_API_KEY=
SCHOOLINFO_API_KEY=
KOSIS_API_KEY=
CAREER_NET_API_KEY=
# Legacy alias; prefer PUBLIC_DATA_API_KEY.
DATA_GO_KR_API_KEY=
PUBLIC_DATA_REGION_CODE=47210
PUBLIC_DATA_DEFAULT_OFFICE_CODE=R10

# Demo
DEMO_SEED_MODE=true
DEMO_SEED_RESET=false
