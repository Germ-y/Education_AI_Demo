generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  externalKey String?  @unique @map("external_key")
  name        String
  type        String
  regionCode  String?  @map("region_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users    User[]
  students Student[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String?  @unique
  displayName    String   @map("display_name")
  role           String
  passwordHash   String?  @map("password_hash")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization       Organization @relation(fields: [organizationId], references: [id])
  ownedCases         SupportCase[] @relation("CaseOwner")
  authoredCaseNotes  CaseNote[]
  createdContents    MissionContent[] @relation("ContentCreator")
  approvedContents   MissionContent[] @relation("ContentApprover")
  auditLogs          AuditLog[]

  @@index([organizationId, role])
  @@map("users")
}

model Student {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  externalKey    String?  @unique @map("external_key")
  displayName    String   @map("display_name")
  grade          String
  schoolCode     String?  @map("school_code")
  studentType    String   @map("student_type")
  primaryNeed    String   @map("primary_need")
  profileJson    Json     @default("{}") @map("profile_json")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization             Organization              @relation(fields: [organizationId], references: [id])
  accounts                 StudentAccount[]
  cases                    SupportCase[]
  memoryCards              MemoryCard[]
  memorySnapshots          MemorySnapshot[]
  contents                 MissionContent[]
  attempts                 ContentAttempt[]
  realtimePracticeSessions RealtimePracticeSession[]
  reviewSummaries          ReviewSummary[]
  plannerItems             PlannerItem[]
  auditLogs                AuditLog[]
  consentRecords           ConsentRecord[]
  agentRuns                AgentRun[]

  @@index([organizationId, studentType])
  @@index([schoolCode])
  @@map("students")
}

model StudentAccount {
  id             String    @id @default(uuid())
  studentId      String    @map("student_id")
  accessCodeHash String    @map("access_code_hash")
  status         String    @default("active")
  lastLoginAt    DateTime? @map("last_login_at")

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, status])
  @@map("student_accounts")
}

model SupportCase {
  id             String    @id @default(uuid())
  studentId      String    @map("student_id")
  ownerTeacherId String    @map("owner_teacher_id")
  caseStatus     String    @default("open") @map("case_status")
  currentGoal    String    @map("current_goal")
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")

  student      Student          @relation(fields: [studentId], references: [id])
  ownerTeacher User             @relation("CaseOwner", fields: [ownerTeacherId], references: [id])
  caseNotes    CaseNote[]
  memoryCards  MemoryCard[]
  contents     MissionContent[]
  plannerItems PlannerItem[]

  @@index([studentId, caseStatus])
  @@index([ownerTeacherId, caseStatus])
  @@map("support_cases")
}

model CaseNote {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  authorId  String   @map("author_id")
  noteType  String   @map("note_type")
  body      String
  visibility String  @default("teacher_only")
  createdAt DateTime @default(now()) @map("created_at")

  supportCase SupportCase @relation(fields: [caseId], references: [id])
  author      User        @relation(fields: [authorId], references: [id])

  @@index([caseId, createdAt])
  @@map("case_notes")
}

model MemoryCard {
  id                          String    @id @default(uuid())
  studentId                   String    @map("student_id")
  caseId                      String?   @map("case_id")
  version                     Int       @default(1)
  learningProblemTypes        String[]  @map("learning_problem_types")
  recent4wResponseJson        Json      @default("{}") @map("recent_4w_response_json")
  emotionalStateNote          String?   @map("emotional_state_note")
  effectiveExplanationStyles  String[]  @map("effective_explanation_styles")
  frequentBlockingUnits       String[]  @map("frequent_blocking_units")
  guardianCooperationStatus   String?   @map("guardian_cooperation_status")
  nextSessionCautions         String[]  @map("next_session_cautions")
  teacherVerifiedAt           DateTime? @map("teacher_verified_at")
  status                      String    @default("active")

  student     Student      @relation(fields: [studentId], references: [id])
  supportCase SupportCase? @relation(fields: [caseId], references: [id])

  @@index([studentId, status])
  @@map("memory_cards")
}

model MemorySnapshot {
  id                  String   @id @default(uuid())
  studentId           String   @map("student_id")
  sourceRangeJson     Json     @default("{}") @map("source_range_json")
  summaryJson         Json     @default("{}") @map("summary_json")
  createdByAgentRunId String?  @map("created_by_agent_run_id")
  createdAt           DateTime @default(now()) @map("created_at")

  student           Student   @relation(fields: [studentId], references: [id])
  createdByAgentRun AgentRun? @relation(fields: [createdByAgentRunId], references: [id])

  @@index([studentId, createdAt])
  @@map("memory_snapshots")
}

model MissionContent {
  id                   String    @id @default(uuid())
  caseId               String    @map("case_id")
  studentId            String    @map("student_id")
  createdByUserId      String?   @map("created_by_user_id")
  orchestratorRunId    String?   @map("orchestrator_run_id")
  contentType          String    @map("content_type")
  title                String
  sessionGoal          String    @map("session_goal")
  status               String
  totalSteps           Int       @default(4) @map("total_steps")
  briefJson            Json      @default("{}") @map("brief_json")
  teacherReviewSummary String?   @map("teacher_review_summary")
  approvedByUserId     String?   @map("approved_by_user_id")
  approvedAt           DateTime? @map("approved_at")
  publishedAt          DateTime? @map("published_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  supportCase     SupportCase   @relation(fields: [caseId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])
  createdByUser   User?         @relation("ContentCreator", fields: [createdByUserId], references: [id])
  orchestratorRun AgentRun?     @relation("ContentOrchestratorRun", fields: [orchestratorRunId], references: [id])
  approvedByUser  User?         @relation("ContentApprover", fields: [approvedByUserId], references: [id])
  stages          ContentStage[]
  assets          ContentAsset[]
  attempts        ContentAttempt[]
  realtimeSessions RealtimePracticeSession[]
  agentRuns       AgentRun[]

  @@index([studentId, status])
  @@index([caseId, createdAt])
  @@map("mission_contents")
}

model ContentStage {
  id               String @id @default(uuid())
  missionContentId String @map("mission_content_id")
  step             Int
  stageRole        String @map("stage_role")
  templateType     String @map("template_type")
  studentTitle     String @map("student_title")
  studentInstruction String @map("student_instruction")
  templateJson     Json   @default("{}") @map("template_json")
  realtimeSpecJson Json?  @map("realtime_spec_json")
  sortOrder        Int    @map("sort_order")

  missionContent  MissionContent            @relation(fields: [missionContentId], references: [id])
  assets          ContentAsset[]
  activityEvents  ActivityEvent[]
  realtimeSessions RealtimePracticeSession[]

  @@unique([missionContentId, step])
  @@index([missionContentId, sortOrder])
  @@map("content_stages")
}

model ContentAsset {
  id               String   @id @default(uuid())
  missionContentId String   @map("mission_content_id")
  stageId          String?  @map("stage_id")
  createdByAgentRunId String? @map("created_by_agent_run_id")
  assetRole        String   @map("asset_role")
  assetType        String   @map("asset_type")
  provider         String
  model            String
  promptJson       Json?    @map("prompt_json")
  storageUrl       String   @map("storage_url")
  previewUrl       String?  @map("preview_url")
  qaStatus         String   @default("pending") @map("qa_status")
  approvalStatus   String   @default("pending") @map("approval_status")
  createdAt        DateTime @default(now()) @map("created_at")

  missionContent MissionContent @relation(fields: [missionContentId], references: [id])
  stage          ContentStage?   @relation(fields: [stageId], references: [id])
  createdByAgentRun AgentRun?    @relation(fields: [createdByAgentRunId], references: [id])

  @@index([missionContentId, assetRole])
  @@map("content_assets")
}

model ContentAttempt {
  id               String    @id @default(uuid())
  missionContentId String    @map("mission_content_id")
  studentId        String    @map("student_id")
  status           String    @default("in_progress")
  currentStep      Int       @default(1) @map("current_step")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  scoreJson        Json?     @map("score_json")

  missionContent  MissionContent            @relation(fields: [missionContentId], references: [id])
  student         Student                   @relation(fields: [studentId], references: [id])
  activityEvents  ActivityEvent[]
  realtimeSessions RealtimePracticeSession[]
  reviewSummaries ReviewSummary[]

  @@index([studentId, status])
  @@map("content_attempts")
}

model ActivityEvent {
  id         String   @id @default(uuid())
  attemptId  String   @map("attempt_id")
  studentId  String   @map("student_id")
  stageId    String?  @map("stage_id")
  eventType  String   @map("event_type")
  payloadJson Json    @default("{}") @map("payload_json")
  occurredAt DateTime @default(now()) @map("occurred_at")

  attempt ContentAttempt @relation(fields: [attemptId], references: [id])
  stage   ContentStage?  @relation(fields: [stageId], references: [id])

  @@index([attemptId, occurredAt])
  @@map("activity_events")
}

model RealtimePracticeSession {
  id               String    @id @default(uuid())
  attemptId        String    @map("attempt_id")
  missionContentId String    @map("mission_content_id")
  stageId          String    @map("stage_id")
  studentId        String    @map("student_id")
  provider         String
  model            String
  status           String    @default("created")
  specSnapshotJson Json      @default("{}") @map("spec_snapshot_json")
  startedAt        DateTime? @map("started_at")
  endedAt          DateTime? @map("ended_at")
  turnCount        Int       @default(0) @map("turn_count")
  durationSec      Int       @default(0) @map("duration_sec")
  rubricResultJson Json?     @map("rubric_result_json")
  transcriptSummary String?  @map("transcript_summary")

  attempt        ContentAttempt @relation(fields: [attemptId], references: [id])
  missionContent MissionContent @relation(fields: [missionContentId], references: [id])
  stage          ContentStage   @relation(fields: [stageId], references: [id])
  student        Student        @relation(fields: [studentId], references: [id])
  events         RealtimePracticeEvent[]

  @@index([studentId, status])
  @@map("realtime_practice_sessions")
}

model RealtimePracticeEvent {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  eventType  String   @map("event_type")
  payloadJson Json    @default("{}") @map("payload_json")
  occurredAt DateTime @default(now()) @map("occurred_at")

  session RealtimePracticeSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, occurredAt])
  @@map("realtime_practice_events")
}

model ReviewSummary {
  id                           String    @id @default(uuid())
  attemptId                    String    @map("attempt_id")
  studentId                    String    @map("student_id")
  agentRunId                   String?   @map("agent_run_id")
  completionRate               Decimal   @map("completion_rate")
  accuracyRate                 Decimal   @map("accuracy_rate")
  shortSummary                 String    @map("short_summary")
  wrongPatternJson             Json      @default("{}") @map("wrong_pattern_json")
  realtimeResultJson           Json      @default("{}") @map("realtime_result_json")
  memoryUpdateCandidateJson    Json      @default("{}") @map("memory_update_candidate_json")
  plannerUpdateCandidateJson   Json      @default("{}") @map("planner_update_candidate_json")
  appliedToMemoryAt            DateTime? @map("applied_to_memory_at")

  attempt  ContentAttempt @relation(fields: [attemptId], references: [id])
  student  Student        @relation(fields: [studentId], references: [id])
  agentRun AgentRun?      @relation(fields: [agentRunId], references: [id])

  @@index([studentId])
  @@map("review_summaries")
}

model PlannerItem {
  id            String @id @default(uuid())
  studentId     String @map("student_id")
  caseId        String @map("case_id")
  periodType    String @map("period_type")
  goalText      String @map("goal_text")
  checklistJson Json   @default("{}") @map("checklist_json")
  status        String @default("planned")

  student     Student     @relation(fields: [studentId], references: [id])
  supportCase SupportCase @relation(fields: [caseId], references: [id])

  @@index([studentId, periodType, status])
  @@map("planner_items")
}

model PublicDataSource {
  id         String  @id @default(uuid())
  sourceCode String @unique @map("source_code")
  name       String
  baseUrl    String? @map("base_url")
  authType   String  @map("auth_type")
  enabled    Boolean @default(true)

  importJobs PublicDataImportJob[]
  rawRecords PublicDataRawRecord[]

  @@map("public_data_sources")
}

model PublicDataImportJob {
  id         String    @id @default(uuid())
  sourceId   String    @map("source_id")
  status     String    @default("pending")
  paramsJson Json      @default("{}") @map("params_json")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  summaryJson Json?    @map("summary_json")

  source     PublicDataSource      @relation(fields: [sourceId], references: [id])
  rawRecords PublicDataRawRecord[]

  @@index([sourceId, status])
  @@map("public_data_import_jobs")
}

model PublicDataRawRecord {
  id          String   @id @default(uuid())
  sourceId    String   @map("source_id")
  importJobId String   @map("import_job_id")
  externalId  String?  @map("external_id")
  rawJson     Json     @default("{}") @map("raw_json")
  retrievedAt DateTime @default(now()) @map("retrieved_at")

  source    PublicDataSource    @relation(fields: [sourceId], references: [id])
  importJob PublicDataImportJob @relation(fields: [importJobId], references: [id])

  @@index([sourceId, externalId])
  @@map("public_data_raw_records")
}

model SchoolProfile {
  id         String @id @default(uuid())
  schoolCode String @unique @map("school_code")
  officeCode String @map("office_code")
  schoolName String @map("school_name")
  regionCode String? @map("region_code")
  rawJson    Json   @default("{}") @map("raw_json")

  calendarEvents SchoolCalendarEvent[]
  timetableSlots SchoolTimetableSlot[]

  @@map("school_profiles")
}

model SchoolCalendarEvent {
  id         String   @id @default(uuid())
  schoolCode String  @map("school_code")
  eventDate  DateTime @map("event_date")
  eventName  String  @map("event_name")
  sourceCode String  @map("source_code")

  school SchoolProfile @relation(fields: [schoolCode], references: [schoolCode])

  @@index([schoolCode, eventDate])
  @@map("school_calendar_events")
}

model SchoolTimetableSlot {
  id         String   @id @default(uuid())
  schoolCode String  @map("school_code")
  slotDate   DateTime @map("slot_date")
  grade      String
  className  String? @map("class_name")
  period     Int
  subject    String
  sourceCode String  @map("source_code")

  school SchoolProfile @relation(fields: [schoolCode], references: [schoolCode])

  @@index([schoolCode, slotDate])
  @@map("school_timetable_slots")
}

model CurriculumStandard {
  id                      String @id @default(uuid())
  source                  String
  curriculumVersion       String @map("curriculum_version")
  schoolLevel             String @map("school_level")
  gradeBand               String @map("grade_band")
  subject                 String
  domain                  String?
  unit                    String
  achievementStandardCode String @unique @map("achievement_standard_code")
  achievementStandardText String @map("achievement_standard_text")
  keywords                String[]
  sourceUrl               String? @map("source_url")

  @@index([schoolLevel, subject, unit])
  @@map("curriculum_standards")
}

model EducationStatIndicator {
  id          String @id @default(uuid())
  sourceCode  String @map("source_code")
  indicatorCode String @map("indicator_code")
  indicatorName String @map("indicator_name")
  regionCode String? @map("region_code")
  schoolLevel String? @map("school_level")
  year        Int
  value       Decimal
  unit        String
  sourceUrl   String? @map("source_url")

  @@index([indicatorCode, year, regionCode])
  @@map("education_stat_indicators")
}

model LocalLearningResource {
  id           String @id @default(uuid())
  sourceCode   String @map("source_code")
  name         String
  resourceType String @map("resource_type")
  regionCode   String? @map("region_code")
  address      String?
  contact      String?
  rawJson      Json   @default("{}") @map("raw_json")

  @@index([regionCode, resourceType])
  @@map("local_learning_resources")
}

model AgentRun {
  id               String    @id @default(uuid())
  agentType        String    @map("agent_type")
  studentId        String?   @map("student_id")
  missionContentId String?   @map("mission_content_id")
  inputSnapshotJson Json     @default("{}") @map("input_snapshot_json")
  outputJson       Json?     @map("output_json")
  modelName        String    @map("model_name")
  status           String    @default("running")
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  student               Student?          @relation(fields: [studentId], references: [id])
  missionContent        MissionContent?   @relation(fields: [missionContentId], references: [id])
  orchestratedContents  MissionContent[]  @relation("ContentOrchestratorRun")
  memorySnapshots       MemorySnapshot[]
  contentAssets         ContentAsset[]
  reviewSummaries       ReviewSummary[]

  @@index([agentType, status])
  @@map("agent_runs")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  studentId   String?  @map("student_id")
  action      String
  resourceType String  @map("resource_type")
  resourceId String?   @map("resource_id")
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser User?    @relation(fields: [actorUserId], references: [id])
  student   Student? @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
  @@map("audit_logs")
}

model ConsentRecord {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  consentType String   @map("consent_type")
  status      String
  grantedBy   String?  @map("granted_by")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, consentType])
  @@map("consent_records")
}
